<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Aurora.Contracts</RootNamespace>
    <AssemblyName>Aurora.Contracts</AssemblyName>
    <PackageId>Aurora.Contracts</PackageId>
    <Description>Versioned Protocol Buffer wire contracts for Aurora components and SDKs.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="..\..\Contracts\proto\aurora\common\v1\types.proto"
              ProtoRoot="..\..\Contracts\proto"
              GrpcServices="None" />
  </ItemGroup>
</Project>
