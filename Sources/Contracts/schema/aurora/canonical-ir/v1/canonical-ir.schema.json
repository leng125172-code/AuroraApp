{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aurora.local/canonical-ir/v1/canonical-ir.schema.json",
  "title": "Aurora Canonical IR Preview v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "documentId", "projectId", "sourceDigest", "capabilities", "units"],
  "properties": {
    "kind": { "const": "aurora.canonical-ir" },
    "schemaVersion": { "$ref": "#/$defs/contractVersion" },
    "documentId": { "$ref": "#/$defs/uuidV7" },
    "projectId": { "$ref": "#/$defs/uuidV7" },
    "sourceDigest": { "$ref": "#/$defs/sha256" },
    "capabilities": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/capability" }
    },
    "units": {
      "description": "Preview 1.0 requires an empty array; Preview 1.1 introduces bounded Aurora ST units.",
      "type": "array",
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/stUnit" }
    },
    "extensions": { "$ref": "#/$defs/extensions" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "properties": { "minor": { "const": 0 } },
            "required": ["minor"]
          }
        }
      },
      "then": { "properties": { "units": { "maxItems": 0 } } }
    }
  ],
  "$defs": {
    "uuidV7": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "capability": { "type": "string", "maxLength": 128, "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+@(?:[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[01][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[01][0-9]{2}|42949672[0-8][0-9]|429496729[0-5])$" },
    "contractVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major", "minor", "lifecycle"],
      "properties": {
        "major": { "const": 1 },
        "minor": { "enum": [0, 1] },
        "lifecycle": { "const": "preview" }
      }
    },
    "extensions": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": { "pattern": "^([a-z][a-z0-9-]*\\.)+[a-z][a-z0-9-]*$" }
    },
    "artifactVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major", "minor"],
      "properties": {
        "major": { "const": 1 },
        "minor": { "const": 0 }
      }
    },
    "u32": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "u64": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,19})$" },
    "boundedRecord": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "propertyNames": { "pattern": "^[a-z][A-Za-z0-9]{0,63}$" }
    },
    "semanticSymbol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "canonicalName", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/u32" },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "canonicalName": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[a-z_][a-z0-9_]*$" },
        "kind": {
          "enum": ["type", "global_variable", "function", "function_block", "program", "enumeration_member", "input_variable", "output_variable", "local_variable", "temporary_variable"]
        },
        "owner": { "$ref": "#/$defs/u32" },
        "valueType": { "$ref": "#/$defs/boundedRecord" }
      }
    },
    "canonicalNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "children"],
      "properties": {
        "id": { "$ref": "#/$defs/u32" },
        "kind": {
          "enum": ["statement_list", "assignment_statement", "function_block_call_statement", "input_argument", "output_argument", "if_statement", "elsif_clause", "else_clause", "for_statement", "return_statement", "binary_expression", "unary_expression", "literal", "qualified_literal", "call_expression", "assignable", "qualified_identifier", "index_suffix", "field_suffix", "parenthesized_expression", "identifier"]
        },
        "text": { "type": "string", "maxLength": 65536 },
        "symbol": { "$ref": "#/$defs/u32" },
        "valueType": { "$ref": "#/$defs/boundedRecord" },
        "faultSite": { "$ref": "#/$defs/u32" },
        "loopIterations": { "$ref": "#/$defs/u64" },
        "children": {
          "type": "array",
          "maxItems": 65536,
          "items": { "$ref": "#/$defs/canonicalNode" }
        }
      }
    },
    "canonicalPou": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "kind", "body"],
      "properties": {
        "symbol": { "$ref": "#/$defs/u32" },
        "kind": { "enum": ["function", "function_block", "program"] },
        "body": { "$ref": "#/$defs/canonicalNode" }
      }
    },
    "taskWork": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "program", "sourceOperations"],
      "properties": {
        "task": { "$ref": "#/$defs/u32" },
        "program": { "$ref": "#/$defs/u32" },
        "sourceOperations": { "$ref": "#/$defs/u64" }
      }
    },
    "stUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "unitId", "languageVersion", "irVersion", "symbols", "types", "programs", "globals", "invocationFrames", "functionBlockInstances", "tags", "snapshotDependencies", "faultSites", "initialization", "tasks", "pous"],
      "properties": {
        "kind": { "const": "aurora.st" },
        "unitId": { "$ref": "#/$defs/uuidV7" },
        "languageVersion": { "const": "1.0" },
        "irVersion": { "$ref": "#/$defs/artifactVersion" },
        "symbols": { "type": "array", "maxItems": 65536, "items": { "$ref": "#/$defs/semanticSymbol" } },
        "types": { "type": "array", "maxItems": 65536, "items": { "$ref": "#/$defs/boundedRecord" } },
        "programs": { "type": "array", "maxItems": 65536, "items": { "$ref": "#/$defs/boundedRecord" } },
        "globals": { "type": "array", "maxItems": 65536, "items": { "$ref": "#/$defs/boundedRecord" } },
        "invocationFrames": { "type": "array", "maxItems": 65536, "items": { "$ref": "#/$defs/boundedRecord" } },
        "functionBlockInstances": { "type": "array", "maxItems": 65536, "items": { "$ref": "#/$defs/boundedRecord" } },
        "tags": { "type": "array", "maxItems": 65536, "items": { "$ref": "#/$defs/boundedRecord" } },
        "snapshotDependencies": { "type": "array", "maxItems": 65536, "items": { "$ref": "#/$defs/boundedRecord" } },
        "faultSites": { "type": "array", "maxItems": 65536, "items": { "$ref": "#/$defs/boundedRecord" } },
        "initialization": { "$ref": "#/$defs/boundedRecord" },
        "tasks": { "type": "array", "maxItems": 65536, "items": { "$ref": "#/$defs/taskWork" } },
        "pous": { "type": "array", "maxItems": 65536, "items": { "$ref": "#/$defs/canonicalPou" } },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    }
  }
}
