{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aurora.local/canonical-ir/v1/canonical-ir.schema.json",
  "title": "Aurora Canonical IR Preview v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "documentId", "projectId", "sourceDigest", "capabilities", "units"],
  "properties": {
    "kind": { "const": "aurora.canonical-ir" },
    "schemaVersion": { "$ref": "#/$defs/contractVersion" },
    "documentId": { "$ref": "#/$defs/uuidV7" },
    "projectId": { "$ref": "#/$defs/uuidV7" },
    "sourceDigest": { "$ref": "#/$defs/sha256" },
    "capabilities": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/capability" }
    },
    "units": {
      "description": "Empty in F0; typed ST and Workflow units are introduced by later contract minors.",
      "type": "array",
      "maxItems": 0
    },
    "extensions": { "$ref": "#/$defs/extensions" }
  },
  "$defs": {
    "uuidV7": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "capability": { "type": "string", "maxLength": 128, "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+@(?:[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[01][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[01][0-9]{2}|42949672[0-8][0-9]|429496729[0-5])$" },
    "contractVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major", "minor", "lifecycle"],
      "properties": {
        "major": { "const": 1 },
        "minor": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "lifecycle": { "const": "preview" }
      }
    },
    "extensions": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": { "pattern": "^([a-z][a-z0-9-]*\\.)+[a-z][a-z0-9-]*$" }
    }
  }
}
